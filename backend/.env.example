# Copy to .env and fill in what you have. Everything is optional:
# with no LLM keys TripSync falls back to rule-based parsing.

# LLM chain: Groq -> Gemini -> Ollama (local)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_MODEL=llama3.1:8b

# Live prices. Flights: Kiwi.com MCP needs no key and is always tried first.
# Hotels: LiteAPI (free sandbox key from dashboard.liteapi.travel, starts with "sand_"), then SerpApi.
# Anything missing falls back to the static price CSVs in data/.
LITEAPI_API_KEY=
SERPAPI_API_KEY=
KIWI_MCP_URL=https://mcp.kiwi.com/

# Nominatim/Overpass require an identifying User-Agent. Put your team email here.
TRIPSYNC_USER_AGENT=TripSync-student-project/0.1 (your-email@example.com)

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripsync

# Set to 1 to skip all network calls (tests / offline demo)
TRIPSYNC_OFFLINE=0
